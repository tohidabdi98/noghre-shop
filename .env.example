# ---------------------------------------------------------------------------
# Environment template — copy to `.env` and fill in locally. NEVER commit `.env`.
# Every value here is a placeholder. Nothing in this file is a real secret.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_NAME=NoghreShop
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Local development only. Production credentials belong in your secret manager.
DATABASE_URL=postgres://app:app@localhost:5432/app_dev
DATABASE_READONLY_URL=

# --- Auth / sessions --------------------------------------------------------
# Generate your own values; never reuse the placeholders below.
SESSION_SECRET=replace-me-with-a-random-32-byte-value
JWT_SIGNING_KEY=replace-me-with-a-random-32-byte-value

# --- External services ------------------------------------------------------
# Only what the approved architecture actually requires. Comment out the rest.
# STRIPE_API_KEY=
# SENDGRID_API_KEY=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Agent / tooling --------------------------------------------------------
# Identity used when an agent must act with a provider token (see
# docs/workflows/security.md). Prefer a fine-grained, least-privilege token or a
# dedicated bot account per role. Never give agents production credentials.
AGENT_ID=
GITHUB_TOKEN=
GITHUB_ACTOR=
